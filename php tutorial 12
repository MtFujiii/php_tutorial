<?php

$products = [
    ['name' => 'shiny star', 'price' => 20],
    ['name' => 'green shell', 'price' => 10],
    ['name' => 'red shell', 'price' => 15],
    ['name' => 'gold coin', 'price' => 5],
    ['name' => 'lightning bolt', 'price' => 40],
    ['name' => 'banana skin', 'price' => 2]
];

foreach ($products as $product) {

    if ($product['name'] === 'lightning bolt') {
        break;
    }

    if ($product['price'] > 15) {
        continue;
    }

    echo $product['name'] . '<br />';

}

// In this tutorial, I learned how break and continue can control a loop.
// break stops the loop completely, while continue skips the current item and continues with the next one. This can be useful when filtering
// or controlling which information is displayed.

?>

